# Copy to .env.local (git-ignored): `cp .env.example .env.local`.
# These are LOCAL development values for the docker compose database
# (`pnpm db:up`). Never put production secrets in this file.

# The app: the read-only role, through the pooled connection on Neon.
DATABASE_URL=postgres://app_readonly:app_readonly@localhost:54329/easy_recipes

# Migrations, scripts and the ingestion job: the owner role, through the
# direct connection on Neon. Set only in GitHub Actions secrets, never in
# Vercel.
DATABASE_URL_DIRECT=postgres://postgres:postgres@localhost:54329/easy_recipes

# The cluster the database tests (`pnpm test:db`) create their databases in.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54329/postgres
