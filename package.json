{
  "name": "easy-recipes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:setup": "node scripts/db/setup-roles.mts",
    "db:seed": "node scripts/db/seed.mts",
    "db:load-curated": "node scripts/db/load-curated.mts",
    "db:load-recipes": "node scripts/db/load-recipes.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.21.0"
}
